{
  "name": "videcoder-docent",
  "version": "0.16.13",
  "private": true,
  "type": "module",
  "description": "바이브코더 도슨트 — 코딩 세션의 작업 내용과 개발 개념을 쉬운 한국어로 설명하는 로컬 웹앱.",
  "license": "MIT",
  "author": "foxion37",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxion37/videcoder-docent.git"
  },
  "homepage": "https://github.com/foxion37/videcoder-docent#readme",
  "bugs": {
    "url": "https://github.com/foxion37/videcoder-docent/issues"
  },
  "keywords": [
    "vibe-coding",
    "docent",
    "omp",
    "claude-code",
    "korean",
    "한국어",
    "바이브코딩"
  ],
  "bin": {
    "docent": "bin/docent.mjs"
  },
  "files": [
    "bin",
    "app/*.mjs",
    "!app/build.mjs",
    "app/index.html",
    "app/favicon.svg",
    "app/assets",
    "prompt",
    "scripts",
    "!scripts/check-design.mjs",
    "adapters",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node app/build.mjs",
    "prepack": "npm run build",
    "start": "node app/server.mjs",
    "transcript": "node scripts/transcript-omp.mjs",
    "transcript:claude": "node scripts/transcript-claude.mjs",
    "check:design": "node scripts/check-design.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.6.0"
  }
}
